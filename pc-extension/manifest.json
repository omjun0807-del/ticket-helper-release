{
  "manifest_version": 3,
  "name": "Ticket Helper PC",
  "version": "0.1.16",
  "description": "Ticket Helper for Keyescape and Naver Booking on Chrome and Edge.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://keyescape.com/*",
    "https://www.keyescape.com/*",
    "https://m.booking.naver.com/*",
    "https://booking.naver.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Ticket Helper PC",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://keyescape.com/*",
        "https://www.keyescape.com/*",
        "https://m.booking.naver.com/*",
        "https://booking.naver.com/*"
      ],
      "js": [
        "bridge-core.js",
        "extension-shim.js",
        "ticket-helper.user.js"
      ],
      "run_at": "document_start"
    }
  ]
}
