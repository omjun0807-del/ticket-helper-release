{
  "manifest_version": 3,
  "name": "Ticket Helper PC",
  "version": "0.1.15",
  "description": "Personal reservation helper for Keyescape and Naver Booking.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://keyescape.com/*",
    "https://www.keyescape.com/*",
    "https://m.booking.naver.com/*",
    "https://booking.naver.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Ticket Helper PC",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://keyescape.com/*",
        "https://www.keyescape.com/*",
        "https://m.booking.naver.com/*",
        "https://booking.naver.com/*"
      ],
      "js": [
        "bridge-core.js",
        "extension-shim.js",
        "ticket-helper.user.js"
      ],
      "run_at": "document_start"
    }
  ]
}
