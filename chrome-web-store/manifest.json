{
  "manifest_version": 3,
  "name": "Ticket Helper PC",
  "version": "0.1.23",
  "description": "Escape-room booking helper with branch/theme catalog and manual confirmation.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://keyescape.com/*",
    "https://www.keyescape.com/*",
    "https://m.booking.naver.com/*",
    "https://booking.naver.com/*",
    "https://api.github.com/*",
    "https://rabbitholeescape.co.kr/*",
    "https://www.rabbitholeescape.co.kr/*",
    "https://play33.kr/*",
    "https://www.play33.kr/*",
    "https://xn--2e0b040a4xj.com/*",
    "https://www.xn--2e0b040a4xj.com/*",
    "https://zeroworldkorea.com/*",
    "https://www.zeroworldkorea.com/*",
    "https://doomescape.com/*",
    "https://www.doomescape.com/*",
    "https://nextedition.co.kr/*",
    "https://www.nextedition.co.kr/*",
    "https://page-today.co.kr/*",
    "https://www.page-today.co.kr/*",
    "https://nabijam.com/*",
    "https://www.nabijam.com/*",
    "https://m.place.naver.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Ticket Helper PC",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://keyescape.com/*",
        "https://www.keyescape.com/*",
        "https://m.booking.naver.com/*",
        "https://booking.naver.com/*",
        "https://rabbitholeescape.co.kr/*",
        "https://www.rabbitholeescape.co.kr/*",
        "https://play33.kr/*",
        "https://www.play33.kr/*",
        "https://xn--2e0b040a4xj.com/*",
        "https://www.xn--2e0b040a4xj.com/*",
        "https://zeroworldkorea.com/*",
        "https://www.zeroworldkorea.com/*",
        "https://doomescape.com/*",
        "https://www.doomescape.com/*",
        "https://nextedition.co.kr/*",
        "https://www.nextedition.co.kr/*",
        "https://page-today.co.kr/*",
        "https://www.page-today.co.kr/*",
        "https://nabijam.com/*",
        "https://www.nabijam.com/*",
        "https://m.place.naver.com/*"
      ],
      "js": [
        "bridge-core.js",
        "extension-shim.js",
        "ticket-helper.user.js"
      ],
      "run_at": "document_start"
    }
  ]
}
